# API Key principal de Google Gemini (obtenible en Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=tu_api_key_aqui

# Rotación automática de múltiples API Keys (separadas por coma) para evitar agotamiento de cuota
# También puedes usar variables numeradas: GEMINI_API_KEY_1, GEMINI_API_KEY_2, etc.
# GEMINI_API_KEYS=key1,key2,key3

# Tiempo en segundos de enfriamiento (cooldown) cuando una key alcanza el límite 429 (por defecto: 60)
# GEMINI_KEY_COOLDOWN_SECONDS=60

# Modelo a utilizar: exclusivamente versión 3.6 (por defecto gemini-3.6-flash)
GEMINI_MODEL=gemini-3.6-flash
