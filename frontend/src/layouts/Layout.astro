---
interface Props {
  title?: string;
}

const { title = "Monitor de Noticias y Redes Sociales UBA" } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body class="bg-slate-950 text-slate-100 min-h-screen font-sans antialiased flex flex-col">
    <slot />
  </body>
</html>

